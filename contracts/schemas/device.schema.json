{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.beyoureyes.app/v3/device.schema.json",
  "title": "Device",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "device_id", "device_profile", "display_name", "android_api",
    "abi", "memory_mb", "gms_available", "event_notifications_enabled",
    "app_version", "revoked_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "device_id": { "$ref": "common.schema.json#/$defs/uuidv7" },
    "device_profile": { "const": "android_arm64_8gb_launch_v1" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "android_api": { "type": "integer", "minimum": 26 },
    "abi": { "const": "arm64-v8a" },
    "memory_mb": { "type": "integer", "minimum": 8192 },
    "gms_available": { "type": "boolean" },
    "event_notifications_enabled": { "type": "boolean" },
    "app_version": { "$ref": "common.schema.json#/$defs/semver" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
