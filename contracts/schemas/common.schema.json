{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.beyoureyes.app/v3/common.schema.json",
  "title": "Be Your Eye common contract definitions",
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "decimalString": {
      "type": "string",
      "description": "Base-10 decimal encoded as JSON text so transport and rule evaluation never depend on binary floating point.",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "version"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalizedRoi": {
      "type": "object",
      "description": "Coordinates normalized to the upright CameraX ViewPort after crop and rotation; setup preview ROI and observation boxes use this same canonical space. A valid region has positive area: left must be strictly less than right and top strictly less than bottom.",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "algorithm",
        "signing_key_id",
        "value"
      ],
      "properties": {
        "canonicalization": {
          "const": "RFC8785"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "signing_key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "confirmedReadingFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "kind", "fractional_digits", "time_segments", "unit"],
      "properties": {
        "profile_id": { "const": "confirmed_reading_format_v2" },
        "kind": { "enum": ["decimal", "percent", "scientific", "time"] },
        "fractional_digits": { "type": "integer", "minimum": 0, "maximum": 12 },
        "time_segments": { "type": ["integer", "null"], "minimum": 2, "maximum": 3 },
        "unit": { "type": ["string", "null"], "minLength": 1, "maxLength": 8 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "time" } }, "required": ["kind"] },
          "then": { "properties": { "fractional_digits": { "const": 0 }, "time_segments": { "type": "integer" }, "unit": { "type": "null" } } },
          "else": { "properties": { "time_segments": { "type": "null" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "percent" } }, "required": ["kind"] },
          "then": { "properties": { "unit": { "const": "%" } } }
        }
      ]
    },
    "structuredReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "display_text",
        "value_decimal",
        "format",
        "unit",
        "confidence",
        "source_kind",
        "observed_at"
      ],
      "properties": {
        "type": {
          "const": "structured_reading"
        },
        "status": {
          "enum": [
            "candidate",
            "stable"
          ]
        },
        "value_decimal": {
          "$ref": "#/$defs/decimalString"
        },
        "display_text": { "type": "string", "minLength": 1, "maxLength": 96 },
        "format": { "$ref": "#/$defs/confirmedReadingFormat" },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_kind": {
          "enum": [
            "digital_display",
            "counter",
            "analog_dial"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
